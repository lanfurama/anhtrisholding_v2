# Sanity — tạo project tại https://www.sanity.io/manage (hoặc `npx sanity init --env`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Token quyền Editor — dùng để lưu yêu cầu báo giá từ form liên hệ (chỉ phía server)
SANITY_API_WRITE_TOKEN=

# Secret cho webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=

# URL chính thức của website (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://anhtrisholdings.com
