# Sanity — tạo project tại https://www.sanity.io/manage (hoặc `npx sanity init --env`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Token quyền Editor — dùng để lưu yêu cầu báo giá từ form liên hệ (chỉ phía server)
SANITY_API_WRITE_TOKEN=

# Secret cho webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=

# URL chính thức của website (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://anhtrisholdings.com

# (Tuỳ chọn) Email báo khi có yêu cầu báo giá mới, gửi qua Resend (https://resend.com)
# QUOTE_NOTIFY_TO: một hoặc nhiều email, cách nhau bằng dấu phẩy
# QUOTE_NOTIFY_FROM: địa chỉ gửi thuộc domain đã xác minh trên Resend, vd. Website AnhTris <no-reply@anhtrisholdings.com>
RESEND_API_KEY=
QUOTE_NOTIFY_TO=
QUOTE_NOTIFY_FROM=

# (Tuỳ chọn) Google Analytics 4 (G-XXXXXXX) và mã xác minh Google Search Console (thẻ meta)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
